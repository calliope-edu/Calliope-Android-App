<?xml version="1.0" encoding="utf-8"?>
<!--
  Bottom navigation item color.
  Active item sits on the brand-accent indicator, so its icon is white
  (brand_on_accent). Inactive items use the themed on-surface-variant so
  they track light/dark mode.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/brand_on_accent" android:state_checked="true" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>
