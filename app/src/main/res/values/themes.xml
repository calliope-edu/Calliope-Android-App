<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================= -->
    <!-- Base application theme — Material Design 3.                    -->
    <!-- Colors come from the md_* roles (values/colors.xml +           -->
    <!-- values-night/colors.xml). Dynamic color is intentionally NOT   -->
    <!-- applied (see App.java), so this brand-seeded scheme is used as  -->
    <!-- is on every device — colorPrimary is the raw brand aqua.        -->
    <!-- ============================================================= -->
    <style name="Theme.CalliopeMini" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Brand typeface: monospace Roboto Mono across the whole UI. -->
        <item name="android:fontFamily">@font/roboto_mono_regular</item>
        <item name="fontFamily">@font/roboto_mono_regular</item>

        <!-- Primary -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>

        <!-- Error -->
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <!-- Background / surface -->
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="android:textColorLink">@color/brand_link</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <!-- Tonal surface containers -->
        <item name="colorSurfaceDim">@color/md_surface_dim</item>
        <item name="colorSurfaceBright">@color/md_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>

        <!-- Shape scale (rounded, keeps the existing brand feel) -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.CalliopeMini.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CalliopeMini.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CalliopeMini.Large</item>

        <!-- Window / system bars -->
        <item name="android:windowBackground">@color/md_surface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/light_system_bars</item>

        <!-- Component theming -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.CalliopeMini.BottomSheetDialog</item>
        <item name="snackbarStyle">@style/Widget.CalliopeMini.Snackbar</item>
        <item name="snackbarButtonStyle">@style/Widget.CalliopeMini.Snackbar.Button</item>
        <item name="snackbarTextViewStyle">@style/Widget.CalliopeMini.Snackbar.TextView</item>
        <item name="checkboxStyle">@style/Widget.CalliopeMini.CheckBox</item>
    </style>

    <!-- ===================== Checkbox ===================== -->
    <!-- Checked state uses the fixed brand aqua (not colorPrimary) so it    -->
    <!-- stays on-brand even under dynamic color; checkmark stays dark.      -->
    <style name="Widget.CalliopeMini.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/checkbox_button_tint</item>
        <item name="buttonIconTint">@color/checkbox_icon_tint</item>
    </style>

    <!-- ===================== Shape appearances ===================== -->
    <style name="ShapeAppearance.CalliopeMini.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.CalliopeMini.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.CalliopeMini.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- ===================== Typography ===================== -->
    <!-- The brand monospace (Roboto Mono) is applied app-wide via the   -->
    <!-- fontFamily on the base theme above. This appearance is kept for  -->
    <!-- views that set android:textAppearance explicitly.               -->
    <style name="TextAppearance.CalliopeMini.Mono" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/roboto_mono_regular</item>
        <item name="fontFamily">@font/roboto_mono_regular</item>
    </style>

    <!-- ===================== Snackbar ===================== -->
    <!-- Background tint is set per-type in SnackbarHelper (aqua/yellow/  -->
    <!-- red); text/action stay white for contrast on those fills.       -->
    <style name="Widget.CalliopeMini.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="actionTextColorAlpha">1</item>
    </style>

    <style name="Widget.CalliopeMini.Snackbar.Button" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.CalliopeMini.Snackbar.TextView" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- ===================== Bottom sheet ===================== -->
    <style name="Widget.CalliopeMini.BottomSheet" parent="Widget.Material3.BottomSheet.Modal" />

    <style name="ThemeOverlay.CalliopeMini.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.CalliopeMini.BottomSheet</item>
    </style>

    <!-- ===================== Bottom navigation ===================== -->
    <!-- Active indicator is transparent so the selected item shows as a    -->
    <!-- plain brand-aqua icon (the master look), instead of a white icon   -->
    <!-- on an aqua pill. Icon colour comes from bottom_nav_item_color.     -->
    <style name="Widget.CalliopeMini.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- ===================== Transparent dialog ===================== -->
    <style name="TransparentAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@color/transparent</item>
    </style>

</resources>
