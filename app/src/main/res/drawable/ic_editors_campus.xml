<?xml version="1.0" encoding="utf-8"?>
<!--
  Calliope Campus editor icon.

  Black rounded square background with the campus favicon (the Calliope
  runner glyph) centred in white. Path data is the campus favicon
  (calliope-campus/static/assets/logos/calliope_campus_favicon.svg)
  translated into the larger 320x320 viewport with a group transform.

  The whole tile is scaled to ~0.78 about the centre so its visual size
  matches the other editor icons, which are airy logo glyphs that don't
  fill the 320 box (e.g. ic_editors_makecode spans ~y:42..277). Without
  this, the full-bleed tile renders noticeably larger in the editor list.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="320dp"
    android:viewportWidth="320"
    android:viewportHeight="320">
    <group
        android:pivotX="160"
        android:pivotY="160"
        android:scaleX="0.78"
        android:scaleY="0.78">
        <!-- Black rounded-square background. -->
        <path
            android:pathData="M40,0L280,0A40,40 0 0,1 320,40L320,280A40,40 0 0,1 280,320L40,320A40,40 0 0,1 0,280L0,40A40,40 0 0,1 40,0Z"
            android:fillColor="#000000" />
        <!-- Campus runner glyph. Source viewBox 27x26; scale ~9.6 and centre
             (offset 30,32) into 320x320. -->
        <group
            android:translateX="30"
            android:translateY="32"
            android:scaleX="9.6"
            android:scaleY="9.6">
            <path
                android:pathData="M24.84,0.52h-4.62c-0.69,0 -1.26,0.56 -1.26,1.26v3.48A5.26,5.26 0,0 0,13.7 0c-2.9,0 -5.26,2.36 -5.26,5.26v5.78L2.2,15.72c-4.21,3.21 -1.94,9.93 3.36,9.93h1.25c0.53,-3.87 1.74,-8.66 4.19,-11.56h5.71c2.49,2.94 3.55,7.67 4.06,11.56h1.77c1.96,0 3.56,-1.59 3.56,-3.56V1.78c0,-0.69 -0.56,-1.26 -1.26,-1.26M11.68,3.37h4.34V6.3c0,0.95 -0.78,1.71 -1.71,1.71h-0.91c-0.95,0 -1.71,-0.78 -1.71,-1.71V3.37zm-1.03,8.49 1.97,-3.76 1.17,3.76zm3.24,0 1.18,-3.79 1.96,3.79zm11.25,-3.25h-5.22V2.18h5.22z"
                android:fillColor="#ffffff" />
            <path
                android:pathData="M11.14,14.09v11.56h6.91c-2.79,-2 -5.07,-7.24 -6.91,-11.56"
                android:fillColor="#ffffff" />
        </group>
    </group>
</vector>
