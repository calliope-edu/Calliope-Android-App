<?xml version="1.0" encoding="utf-8"?>
<!-- FAB-menu label chip: tonal surface + outline, matching the app's
     outlined cards/dialogs. Fully rounded (pill); adapts to light/dark. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/md_surface_container_highest" />
            <stroke android:width="1dp" android:color="@color/stroke_color" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/md_surface_container_highest" />
            <stroke android:width="1dp" android:color="@color/stroke_color" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/md_surface_container_high" />
            <stroke android:width="1dp" android:color="@color/stroke_color" />
        </shape>
    </item>
</selector>
