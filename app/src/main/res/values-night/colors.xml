<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================= -->
    <!-- Material Design 3 color roles (DARK) — brand seed #00C8C6.      -->
    <!-- Mirrors the role names in values/colors.xml; the single theme   -->
    <!-- in values/themes.xml picks the right set per night mode.        -->
    <!--                                                                  -->
    <!-- The neutral SURFACE roles are deliberately re-toned onto the     -->
    <!-- classic Calliope navy (#131720, the dark_blue_900 used on the    -->
    <!-- official Calliope sites) instead of the teal-grey the seed would -->
    <!-- generate, so the dark background matches the brand. Primary is   -->
    <!-- pinned to the raw brand aqua (below); the secondary/tertiary     -->
    <!-- accents are left on the seed-derived scheme.                     -->
    <!-- ============================================================= -->
    <!-- Primary pinned to the raw brand aqua #00C8C6 (NOT tonalized). -->
    <color name="md_primary">#00C8C6</color>
    <color name="md_on_primary">#131720</color>
    <color name="md_primary_container">#1F4E4D</color>
    <color name="md_on_primary_container">#A4F0EE</color>
    <!-- Secondary = raw brand aqua #00C8C6 too (not tonalized). -->
    <color name="md_secondary">#00C8C6</color>
    <color name="md_on_secondary">#131720</color>
    <color name="md_secondary_container">#324B4A</color>
    <color name="md_on_secondary_container">#CCE8E6</color>
    <color name="md_tertiary">#A2CDE8</color>
    <color name="md_on_tertiary">#02344B</color>
    <color name="md_tertiary_container">#214B5F</color>
    <color name="md_on_tertiary_container">#BFE9FF</color>
    <color name="md_error">#FFB4AB</color>
    <color name="md_on_error">#690005</color>
    <color name="md_error_container">#93000A</color>
    <color name="md_on_error_container">#FFDAD6</color>
    <!-- Neutral surfaces re-toned onto the Calliope navy (#131720). -->
    <color name="md_background">#131720</color>
    <color name="md_on_background">#E3E2E9</color>
    <color name="md_surface">#131720</color>
    <color name="md_on_surface">#E3E2E9</color>
    <color name="md_surface_variant">#43474F</color>
    <color name="md_on_surface_variant">#C3C6CF</color>
    <color name="md_outline">#8D9099</color>
    <color name="md_outline_variant">#43474F</color>
    <color name="md_inverse_surface">#E3E2E9</color>
    <color name="md_inverse_on_surface">#2E323B</color>
    <color name="md_inverse_primary">#1B6968</color>
    <color name="md_surface_dim">#131720</color>
    <color name="md_surface_bright">#393D47</color>
    <color name="md_surface_container_lowest">#0E1119</color>
    <color name="md_surface_container_low">#1B1F29</color>
    <color name="md_surface_container">#1F232E</color>
    <color name="md_surface_container_high">#232730</color>
    <color name="md_surface_container_highest">#2E323C</color>
    <color name="md_scrim">#000000</color>

    <!-- Dark icon fills (unchanged) -->
    <color name="grey_transparent_light">#20C1C1C1</color>
    <color name="ic_fill_primary">#FFFFFFFF</color>
    <color name="ic_fill_secondary">#FF131720</color>
    <color name="ic_fill_pattern">#FF131720</color>

    <!-- Link text: the vivid brand aqua reads well on dark surfaces (~8:1). -->
    <color name="brand_link">#FF00C8C6</color>

    <!-- Semantic aliases (dark) -->
    <color name="item_text">@color/md_on_surface</color>
    <color name="item_icon">@color/md_on_surface_variant</color>
    <color name="item_background">@color/md_surface_container_low</color>
    <color name="nav_background">@color/md_surface_container_high</color>
    <color name="stroke_color">@color/md_outline_variant</color>
    <color name="background_solid">@color/md_surface</color>
    <color name="background_transparent">#00131720</color>
</resources>
